# {{ ansible_managed }}
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name {{ nginx_server_name }};

    root /var/www/html;
    index index.html;

    server_tokens off;
    add_header X-Content-Type-Options nosniff;
    add_header X-Frame-Options DENY;

    location / {
        try_files $uri $uri/ =404;
    }
}
